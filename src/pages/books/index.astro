---
import Base from "../../layouts/Base.astro";
---

<Base title="Books · Banashri" description="Reading list and covers.">
  <main>
    <h1 class="page-title">Books</h1>
    <div class="books-intro prose">
      <p>
        Bücher sind mein bester Freund und eines Tages möchte ich meine eigene
        Bibliothek abbauen.
      </p>
      <p>
        <a href="/books/read">Gelesene Bücher →</a>
      </p>
    </div>
    <p style="margin-top: 2rem;">
      <img
        src="https://banashri.github.io/images/books.jpg"
        alt=""
        width={800}
        height={400}
        loading="lazy"
        style="width: 100%; height: auto; border-radius: 2px; opacity: 0.85;"
      />
    </p>
  </main>
</Base>
