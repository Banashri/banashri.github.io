---

<div class="books-grid">
  {
    covers.map(({ href, img: im }) => (
      <a href={href} target="_blank" rel="noopener noreferrer">
        <img src={im.src} alt={im.alt} width={150} height={225} loading="lazy" />
      </a>
    ))
  }
</div>
